# cSpell:disable
# Copy this file to `.env` and fill in real values.
# Everything is required unless marked "Optional".

PROJECT_NAME=IrenesBot

# [TWITCH]
# IrenesBot application at @Irene developer console (production bot)
TWITCH_CLIENT_ID=client_id
TWITCH_CLIENT_SECRET=secret
# IrenesTest application at @Irene_Adler__ developer console (test bot)
TEST_TWITCH_CLIENT_ID=test_client_id
TEST_TWITCH_CLIENT_SECRET=test_secret
# Randomly chosen secret for EventSub webhooks, the Twitch CLI uses it too
EVENTSUB=some_random_string

# [POSTGRES]
# Password for the `db` container in compose.yml
POSTGRES_PASSWORD=password
# Used on Linux (the VPS)
POSTGRES_VPS=postgresql://username:${POSTGRES_PASSWORD}@hostname:5432/irenesbot
# Used everywhere else (my home PC)
POSTGRES_HOME=postgresql://username:password@localhost:5432/irenesbot

# [7TV]
SEVEN_TV_BEARER=Bearer xdd_why_the_hell_all_bearer_tokens_are_so_long_it_s_kinda_annoying
# Password for the `/stv-token` web page where a new 7TV token can be submitted at runtime
STV_TOKEN_PAGE_KEY=some_long_random_string
# Optional: bot account's twitch.tv `persistent` cookie, lets the bot renew its 7TV token automatically
TWITCH_BOT_PERSISTENT_COOKIE=123456789%3A%3Aabcdef

# [API KEYS]
STEAM_API_KEY=abc
# Username part of the spotify.aidenwallis.co.uk/u/<username> link
SPOTIFY_AIDENWALLIS=abc
# Key for the local API provided by my Dota2Bot
LOCAL_API_KEY=abc

# [WEBHOOKS]
# 🐬ire_logs
WEBHOOK_LOGGER=https://discord.com/api/webhooks/123/abcdf
# 🐟ire_spam
WEBHOOK_ERROR=https://discord.com/api/webhooks/123/abcdf
# 🐟ire_spam
WEBHOOK_SPAM=https://discord.com/api/webhooks/123/abcdf
# 👑stream_notifs
WEBHOOK_STREAM_NOTIF=https://discord.com/api/webhooks/123/abcdf

# [MONITORING]
# Optional: healthchecks.io ping URL, the bot pings it every 5 minutes while it's alive.
# Only the systemd service on the VPS pings it, so it's safe to keep the same value in a home .env too.
HEALTHCHECK_URL=https://hc-ping.com/your-ping-key/irenesbot
