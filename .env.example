TWITCH_CLIENT_ID=client_id
TWITCH_CLIENT_SECRET=secret

# IrenesTest application at @Irene_Adler__ developer console
TEST_TWITCH_CLIENT_ID=test_client_id
TEST_TWITCH_CLIENT_SECRET=test_secret

# [POSTGRES]
POSTGRES_PASSWORD=password
POSTGRES_VPS=postgres://YourUserName:${POSTGRES_PASSWORD}@YourHostname:5432/YourDatabaseName
POSTGRES_HOME=postgresql://[user[:password]@][netloc][:port][/dbname][?param1=value1&...]

# [STEAM.IRENESTEST]
STEAM_IRENESTEST_USERNAME=username
STEAM_IRENESTEST_PASSWORD=password

# [STEAM.IRENESBOT]
STEAM_IRENESBOT_USERNAME=username
STEAM_IRENESBOT_PASSWORD=password

# [TOKENS]
STRATZ_BEARER=why_the_hell_stratz_bearer_token_is_9999_symbols_it_s_kinda_annoying
STEAM_API_KEY=abc
SPOTIFY_AIDENWALLIS=abc
# Randomly chosen by me eventsub_secret, i.e. used by Twitch CLI
EVENTSUB=123 
SEVEN_TV_BEARER=Bearer xdd_why_the_hell_all_bearer_tokens_are_so_long_it_s_kinda_annoying
# Password for the `/stv-token` web page where a new 7TV token can be submitted at runtime
STV_TOKEN_PAGE_KEY=some_long_random_string
# Optional: bot account's twitch.tv `persistent` cookie, lets the bot renew its 7TV token automatically
TWITCH_BOT_PERSISTENT_COOKIE=123456789%3A%3Aabcdef

